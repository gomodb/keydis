# Maintainer: KeyDis contributors
pkgname=keydis
pkgver=0.4.3
pkgrel=1
pkgdesc="Native Redis/Valkey client for KDE"
arch=('x86_64' 'aarch64')
url="https://github.com/gomodb/keydis"
license=('MIT')
depends=(
  'qt6-base'
  'kf6-kconfig'
  'kf6-kconfigwidgets'
  'kf6-kcolorscheme'
  'kf6-kcoreaddons'
  'kf6-kdbusaddons'
  'kf6-ki18n'
  'kf6-kwallet'
  'kf6-kxmlgui'
  'hiredis'
)
makedepends=(
  'cmake'
  'ninja'
  'pkgconf'
  'extra-cmake-modules'
  'qt6-tools'
  'kf6-krunner'
)
optdepends=('kwallet: password storage' 'openssh: SSH tunnel support' 'kf6-krunner: KRunner integration')
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname-$pkgver" -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DKEYDIS_USE_SYSTEM_HIREDIS=ON \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
