# SPDX-License-Identifier: MIT

pkgname=keydis
pkgver=0.4.39
pkgrel=1
pkgdesc='Native Redis/Valkey client for KDE'
arch=('x86_64' 'aarch64')
url='https://github.com/gomodb/keydis'
license=('MIT')
depends=(
    'qt6-base'
    'kconfig'
    'kconfigwidgets'
    'kcolorscheme'
    'kcoreaddons'
    'kdbusaddons'
    'ki18n'
    'kwallet'
    'kxmlgui'
    'krunner'
    'hicolor-icon-theme'
    'hiredis'
  'zlib'
  'zstd'
  'brotli'
  'msgpack-c'
)
makedepends=('cmake' 'ninja' 'pkgconf' 'qt6-tools')
optdepends=(
    'kwalletmanager: KWallet management UI'
    'openssh: SSH tunnel support'
)
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/gomodb/keydis/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2b5826cf96afc3efbaa987cc41c0340cdbea43d52b9077cbf35e82f32620fd2c')

build() {
    cmake -S "$srcdir/$pkgname-$pkgver" -B "$srcdir/$pkgname-$pkgver/build" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKEYDIS_USE_SYSTEM_HIREDIS=ON \
        -DBUILD_TESTING=ON \
        -Wno-dev
    cmake --build "$srcdir/$pkgname-$pkgver/build"
}

check() {
    ctest --test-dir "$srcdir/$pkgname-$pkgver/build" --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/$pkgname-$pkgver/build"
}
