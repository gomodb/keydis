# Maintainer: KeyDis contributors
pkgname=keydis
pkgver=0.4.16
pkgrel=1
pkgdesc="Native Redis/Valkey client for KDE"
arch=('x86_64' 'aarch64')
url="https://github.com/gomodb/keydis"
license=('MIT')
depends=(
  'qt6-base'
  'kconfig'
  'kconfigwidgets'
  'kcolorscheme'
  'kcoreaddons'
  'kdbusaddons'
  'ki18n'
  'kwallet'
  'kxmlgui'
  'krunner'
  'hiredis'
)
makedepends=(
  'cmake'
  'ninja'
  'pkgconf'
  'qt6-tools'
)
optdepends=('kwalletmanager: KWallet management UI' 'openssh: SSH tunnel support')
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname-$pkgver" -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DKEYDIS_USE_SYSTEM_HIREDIS=ON \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
